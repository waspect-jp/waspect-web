---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Manuscript from '../../components/Manuscript.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { t, localePath, getStaticPaths as gsp, type Lang } from '../../i18n/utils';
import { jp } from '../../i18n/jp';

import classroom from '../../assets/photos/classroom-tablet.jpg';
import business from '../../assets/photos/business-presentation.jpg';
import parentChild from '../../assets/photos/parent-child.jpg';
import shimoda from '../../assets/photos/shimoda-high-session.jpg';
import founders from '../../assets/photos/founders-newswitch.jpg';
import logoNewspicks from '../../assets/media/media-newspicks.png';
import logoDmenu from '../../assets/media/media-dmenu.png';
import logoGoo from '../../assets/media/media-goo.png';

export const getStaticPaths = gsp;
const { lang } = Astro.props as { lang: Lang };
const T = (key: string) => jp(lang, t(lang, key));
const isJa = lang === 'ja';

const audiences = [
  { path: '/schools', img: classroom, title: 'home.who.schools.title', desc: 'home.who.schools.desc', alt: isJa ? '教室でタブレットを使う生徒たち' : 'Students using tablets in a classroom' },
  { path: '/businesses', img: business, title: 'home.who.biz.title', desc: 'home.who.biz.desc', alt: isJa ? '会議室でプレゼンテーションをする女性' : 'A woman presenting in a meeting room' },
  { path: '/kids', img: parentChild, title: 'home.who.parents.title', desc: 'home.who.parents.desc', alt: isJa ? '親子で画面を見ながら学ぶ様子' : 'A parent and child learning together' },
];

const pillars = [
  { icon: 'brain', title: 'home.pillars.1.title', desc: 'home.pillars.1.desc' },
  { icon: 'globe', title: 'home.pillars.2.title', desc: 'home.pillars.2.desc' },
  { icon: 'hammer', title: 'home.pillars.3.title', desc: 'home.pillars.3.desc' },
] as const;

const caseFacts = ['home.case.f1', 'home.case.f2', 'home.case.f3', 'home.case.f4'];

const articles = [
  { url: 'https://prtimes.jp/main/html/rd/p/000000001.000166452.html', img: shimoda, alt: 'home.case.alt', date: 'home.media.1.date', source: 'home.media.1.source', title: 'home.media.1.title' },
  { url: 'https://newswitch.jp/p/39164', img: founders, alt: 'home.media.2.alt', date: 'home.media.2.date', source: 'home.media.2.source', title: 'home.media.2.title' },
];
---

<BaseLayout title={t(lang, 'meta.home.title')} description={t(lang, 'meta.home.desc')} activePage="home" lang={lang}>
  <!-- Hero: the message, written on manuscript paper -->
  <section class="relative overflow-hidden pt-6 pb-16 lg:pt-14 lg:pb-24">
    <div class="wrap grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class:list={['hero-stage lg:col-span-6', isJa ? 'order-2 lg:order-1' : 'order-1']}>
        <p class="eng-note" lang={isJa ? 'en' : 'ja'}>{t(lang, 'home.hero.en')}</p>
        {isJa ? (
          <h1 class="sr-only">{t(lang, 'home.hero.title')}</h1>
        ) : (
          <h1 class="h1 mt-4 max-w-[18ch]" set:html={T('home.hero.title')} />
        )}
        <p class:list={['lead max-w-[34em]', isJa ? 'mt-5 text-[1.125rem] lg:text-[1.3125rem] lg:leading-[1.95]' : 'mt-6']} set:html={T('home.hero.lead')} />
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={localePath(lang, '/contact')} class="btn btn-primary btn-lg">
            {t(lang, 'home.hero.btn')}
            <Icon name="arrow" size={18} class="ic-arrow" />
          </a>
          <a href="#who" class="btn btn-ghost btn-lg">{t(lang, 'home.hero.btn2')}</a>
        </div>
        <ul class="facts mt-8">
          {['home.hero.fact1', 'home.hero.fact2', 'home.hero.fact3'].map((k) => (
            <li class="fact"><Icon name="check" size={16} />{t(lang, k)}</li>
          ))}
        </ul>
      </div>
      <div class:list={['lg:col-span-6', isJa ? 'order-1 lg:order-2' : 'order-2']}>
        <Manuscript label={t(lang, 'home.sheet.caption')} />
      </div>
    </div>
  </section>

  <!-- Who we help -->
  <section class="section tint" id="who">
    <div class="wrap">
      <SectionHead title={T('home.who.title')} lead={T('home.who.lead')} />
      <div class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-16 lg:gap-6" data-reveal-stagger>
        {audiences.map((a) => (
          <a href={localePath(lang, a.path)} class="card group flex flex-col no-underline">
            <div class="card-media aspect-[4/3]">
              <Image src={a.img} alt={a.alt} width={900} widths={[420, 640, 900]} sizes="(min-width: 768px) 33vw, 100vw" format="webp" quality={78} />
            </div>
            <div class="flex flex-1 flex-col p-6 lg:p-7">
              <h3 class="h3" set:html={T(a.title)} />
              <p class="small muted mt-3 flex-1 leading-relaxed" set:html={T(a.desc)} />
              <span class="link small mt-6 self-start">
                {t(lang, 'common.learnMore')}
                <Icon name="arrow" size={16} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Three pillars -->
  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHead title={T('home.pillars.title')} lead={T('home.pillars.lead')} class="lg:sticky lg:top-28" />
      </div>
      <ul class="ruled lg:col-span-7" data-reveal-stagger>
        {pillars.map((p) => (
          <li class="grid grid-cols-[auto_1fr] gap-5 py-7 lg:gap-7 lg:py-9">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-mint text-rule-deep">
              <Icon name={p.icon} size={22} />
            </span>
            <div>
              <h3 class="h3" set:html={T(p.title)} />
              <p class="muted mt-2 max-w-[38em] leading-relaxed" set:html={T(p.desc)} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- In practice: Shimoda High School -->
  <section class="section-tight">
    <div class="wrap">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16" data-reveal>
        <div class="frame aspect-[16/10] bg-mist lg:col-span-7">
          <Image src={shimoda} alt={t(lang, 'home.case.alt')} width={1400} widths={[640, 960, 1400]} sizes="(min-width: 1024px) 58vw, 100vw" format="webp" quality={80} />
        </div>
        <div class="lg:col-span-5">
          <span class="chip">{t(lang, 'home.case.label')}</span>
          <h2 class="h2 mt-4" set:html={T('home.case.title')} />
          <p class="muted mt-4 leading-relaxed" set:html={T('home.case.desc')} />
          <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
            {caseFacts.map((k) => (
              <li class="fact"><Icon name="check-circle" size={16} />{t(lang, k)}</li>
            ))}
          </ul>
          <a href={articles[0].url} target="_blank" rel="noopener noreferrer" class="link mt-7">
            {t(lang, 'home.case.link')}
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- In the media -->
  <section class="section tint">
    <div class="wrap">
      <SectionHead title={T('home.media.title')} lead={T('home.media.lead')} />
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:gap-6" data-reveal-stagger>
        {articles.map((a) => (
          <a href={a.url} target="_blank" rel="noopener noreferrer" class="card group flex flex-col no-underline">
            <div class="card-media aspect-[16/9]">
              <Image src={a.img} alt={t(lang, a.alt)} width={1200} widths={[560, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" format="webp" quality={78} />
            </div>
            <div class="flex flex-1 flex-col p-6 lg:p-7">
              <p class="small muted flex flex-wrap gap-x-4 gap-y-1">
                <time class="latin tabular-nums">{t(lang, a.date)}</time>
                <span>{t(lang, a.source)}</span>
              </p>
              <h3 class="h3 mt-3 flex-1" set:html={T(a.title)} />
              <span class="link small mt-6 self-start">
                {t(lang, 'home.media.read')}
                <Icon name="arrow-up-right" size={16} />
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-12 flex flex-wrap items-center gap-x-10 gap-y-5" data-reveal>
        <p class="small muted">{t(lang, 'home.media.also')}</p>
        <div class="flex flex-wrap items-center gap-x-10 gap-y-5 opacity-70 grayscale">
          <Image src={logoNewspicks} alt="NewsPicks" height={40} format="png" class="h-10 w-auto" />
          <Image src={logoDmenu} alt="dmenu" height={22} format="png" class="h-[22px] w-auto" />
          <Image src={logoGoo} alt="goo" height={28} format="png" class="h-7 w-auto" />
        </div>
      </div>
    </div>
  </section>

  <CtaBand title={T('home.cta.title')} desc={T('home.cta.desc')} href={localePath(lang, '/contact')} label={t(lang, 'home.cta.btn')} />
</BaseLayout>
