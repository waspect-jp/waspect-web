---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { t, localePath, getStaticPaths as gsp, type Lang } from '../../i18n/utils';
import { jp } from '../../i18n/jp';
import parentChild from '../../assets/photos/parent-child.jpg';

export const getStaticPaths = gsp;
const { lang } = Astro.props as { lang: Lang };
const T = (key: string) => jp(lang, t(lang, key));

const learn = [
  { icon: 'brain', title: 'kids.learn.1.title', desc: 'kids.learn.1.desc' },
  { icon: 'globe', title: 'kids.learn.2.title', desc: 'kids.learn.2.desc' },
  { icon: 'lightbulb', title: 'kids.learn.3.title', desc: 'kids.learn.3.desc' },
  { icon: 'palette', title: 'kids.learn.4.title', desc: 'kids.learn.4.desc' },
] as const;

const stages = [
  { key: 'young', icon: 'smile' },
  { key: 'old', icon: 'rocket' },
] as const;

const contactHref = localePath(lang, '/contact?who=parent');
---

<BaseLayout title={t(lang, 'meta.kids.title')} description={t(lang, 'meta.kids.desc')} activePage="kids" lang={lang}>
  <PageHero title={T('kids.hero.title')} lead={T('kids.hero.lead')} image={parentChild} alt={t(lang, 'kids.hero.alt')} position="50% 40%">
    <Fragment slot="actions">
      <a href={contactHref} class="btn btn-primary btn-lg w-full sm:w-auto">
        {t(lang, 'kids.hero.btn2')}
        <Icon name="arrow" size={18} class="ic-arrow" />
      </a>
      <a href="#program" class="btn btn-ghost btn-lg w-full sm:w-auto">{t(lang, 'kids.hero.btn')}</a>
    </Fragment>
    <Fragment slot="facts">
      <span class="fact"><Icon name="sparkles" size={16} />{t(lang, 'kids.hero.tag')}</span>
      <span class="fact"><Icon name="clock" size={16} />{t(lang, 'kids.hero.status')}</span>
    </Fragment>
    <Fragment slot="overlay">
      <figure class="card absolute -bottom-5 left-5 right-5 m-0 px-5 py-4 shadow-float sm:left-auto sm:right-6 sm:max-w-[20rem] lg:-bottom-6 lg:right-8">
        <blockquote class="small font-bold leading-relaxed text-ink" set:html={T('kids.hero.quote')} />
      </figure>
    </Fragment>
  </PageHero>

  <!-- Why -->
  <section class="section tint">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHead title={T('kids.why.title')} />
      </div>
      <div class="lg:col-span-6" data-reveal>
        <p class="lead" set:html={T('kids.why.body')} />
        <p class="mt-8 border-l-[3px] border-rule pl-6 text-[1.25rem] font-bold leading-relaxed text-ink" set:html={T('kids.why.callout')} />
      </div>
    </div>
  </section>

  <!-- What children learn -->
  <section class="section" id="program">
    <div class="wrap">
      <SectionHead title={T('kids.learn.title')} />
      <ul class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4" data-reveal-stagger>
        {learn.map((l) => (
          <li class="border-t border-rule-soft pt-6">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-mint text-rule-deep">
              <Icon name={l.icon} size={22} />
            </span>
            <h3 class="h3 mt-5" set:html={T(l.title)} />
            <p class="small muted mt-2 leading-relaxed" set:html={T(l.desc)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Stages -->
  <section class="section tint">
    <div class="wrap">
      <SectionHead title={T('kids.age.title')} lead={T('kids.age.lead')} />
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-16 lg:gap-6" data-reveal-stagger>
        {stages.map((s) => (
          <article class="card p-7 lg:p-9">
            <div class="flex items-center justify-between gap-4">
              <span class="chip">{t(lang, `kids.age.${s.key}.label`)}</span>
              <span class="grid h-11 w-11 place-items-center rounded-full bg-mint text-rule-deep">
                <Icon name={s.icon} size={20} />
              </span>
            </div>
            <h3 class="h2 mt-5" set:html={T(`kids.age.${s.key}.phase`)} />
            <p class="muted mt-3 leading-relaxed" set:html={T(`kids.age.${s.key}.desc`)} />
            <ul class="mt-6 grid gap-2.5 border-t border-rule-soft pt-6">
              {[1, 2, 3].map((n) => (
                <li class="fact text-ink"><Icon name="check" size={16} />{t(lang, `kids.age.${s.key}.${n}`)}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title={T('kids.cta.title')} desc={T('kids.cta.desc')} href={contactHref} label={t(lang, 'kids.cta.btn')} id="register" />
</BaseLayout>
