---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { t, localePath, getStaticPaths as gsp, type Lang } from '../../i18n/utils';
import { jp } from '../../i18n/jp';
import shimoda from '../../assets/photos/shimoda-high-session.jpg';

export const getStaticPaths = gsp;
const { lang } = Astro.props as { lang: Lang };
const T = (key: string) => jp(lang, t(lang, key));

const stances = [
  { icon: 'brain', title: 'schools.why.p1.title', desc: 'schools.why.p1.desc' },
  { icon: 'palette', title: 'schools.why.p2.title', desc: 'schools.why.p2.desc' },
  { icon: 'compass', title: 'schools.why.p3.title', desc: 'schools.why.p3.desc' },
] as const;

const programs = [1, 2, 3, 4].map((n) => ({
  title: `schools.prog.${n}.title`,
  grade: `schools.prog.${n}.grade`,
  sessions: `schools.prog.${n}.sessions`,
  desc: `schools.prog.${n}.desc`,
  bullets: [`schools.prog.${n}.b1`, `schools.prog.${n}.b2`, `schools.prog.${n}.b3`],
  outcome: `schools.prog.${n}.outcome`,
  caseLink: n === 1 ? 'https://prtimes.jp/main/html/rd/p/000000001.000166452.html' : undefined,
}));

const common = [
  { icon: 'languages', title: 'schools.common.1.title', desc: 'schools.common.1.desc' },
  { icon: 'flask', title: 'schools.common.2.title', desc: 'schools.common.2.desc' },
  { icon: 'sliders', title: 'schools.common.3.title', desc: 'schools.common.3.desc' },
  { icon: 'shield', title: 'schools.common.4.title', desc: 'schools.common.4.desc' },
] as const;

const steps = [1, 2, 3, 4].map((n) => ({ title: `schools.journey.${n}`, desc: `schools.journey.${n}.desc` }));
const contactHref = localePath(lang, '/contact?who=school');
---

<BaseLayout title={t(lang, 'meta.schools.title')} description={t(lang, 'meta.schools.desc')} activePage="schools" lang={lang}>
  <PageHero title={T('schools.hero.title')} lead={T('schools.hero.lead')} image={shimoda} alt={t(lang, 'schools.hero.alt')} position="60% 50%">
    <Fragment slot="actions">
      <a href={contactHref} class="btn btn-primary btn-lg w-full sm:w-auto">
        <span set:html={T('schools.hero.btn')} />
        <Icon name="arrow" size={18} class="ic-arrow" />
      </a>
      <a href="#programs" class="btn btn-ghost btn-lg w-full sm:w-auto" set:html={T('schools.hero.btn2')} />
    </Fragment>
    <Fragment slot="facts">
      <span class="fact"><Icon name="check" size={16} />{t(lang, 'schools.hero.fact1')}</span>
      <span class="fact"><Icon name="check" size={16} />{t(lang, 'schools.hero.fact2')}</span>
    </Fragment>
  </PageHero>

  <!-- Why: thinking, creating and solving with AI -->
  <section class="section tint">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHead title={T('schools.why.title')} />
        <p class="muted mt-6 max-w-[38em] leading-relaxed" set:html={T('schools.why.body')} data-reveal />
      </div>
      <ul class="ruled lg:col-span-6" data-reveal-stagger>
        {stances.map((s) => (
          <li class="grid grid-cols-[auto_1fr] gap-5 py-6">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-white text-rule-deep ring-1 ring-rule-soft">
              <Icon name={s.icon} size={22} />
            </span>
            <div>
              <h3 class="h3" set:html={T(s.title)} />
              <p class="small muted mt-1.5 leading-relaxed" set:html={T(s.desc)} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Programs -->
  <section class="section" id="programs">
    <div class="wrap">
      <SectionHead title={T('schools.programs.title')} lead={T('schools.programs.lead')} />
      <div class="mt-10 border-t border-rule-soft lg:mt-14" data-reveal>
        {programs.map((p, i) => (
          <details class="disc" open={i === 0}>
            <summary>
              <span class="flex flex-wrap gap-2">
                <span class="chip">{t(lang, p.grade)}</span>
                <span class="chip chip-ink">{t(lang, p.sessions)}</span>
              </span>
              <h3 class="h3 mt-3 lg:text-[1.375rem]" set:html={T(p.title)} />
              <span class="disc-icon" aria-hidden="true"><Icon name="plus" size={18} /></span>
            </summary>
            <div class="disc-body grid gap-8 lg:grid-cols-12 lg:gap-12">
              <div class="lg:col-span-7">
                <p class="muted leading-relaxed" set:html={T(p.desc)} />
                <ul class="mt-5 grid gap-2.5">
                  {p.bullets.map((b) => (
                    <li class="fact text-ink"><Icon name="check" size={16} />{t(lang, b)}</li>
                  ))}
                </ul>
              </div>
              <div class="small grid content-start gap-4 rounded-2xl bg-mist p-6 lg:col-span-5">
                <dl class="grid gap-4">
                  <div>
                    <dt class="muted">{t(lang, 'schools.programs.meta.outcome')}</dt>
                    <dd class="mt-0.5 font-bold text-ink" set:html={T(p.outcome)} />
                  </div>
                </dl>
                {p.caseLink && (
                  <p class="border-t border-rule-soft pt-4">
                    <a href={p.caseLink} target="_blank" rel="noopener noreferrer" class="link small">
                      {t(lang, 'schools.prog.case')}
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  </p>
                )}
              </div>
            </div>
          </details>
        ))}
      </div>

      <div class="mt-16 lg:mt-20">
        <h3 class="h3" set:html={T('schools.common.title')} />
        <ul class="mt-6 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
          {common.map((c) => (
            <li class="flex gap-4 lg:block">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-mint text-rule-deep">
                <Icon name={c.icon} size={20} />
              </span>
              <div class="lg:mt-4">
                <h4 class="font-bold text-ink" set:html={T(c.title)} />
                <p class="small muted mt-1.5 leading-relaxed" set:html={T(c.desc)} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Journey -->
  <section class="section tint">
    <div class="wrap">
      <SectionHead title={T('schools.journey.title')} lead={T('schools.journey.lead')} />
      <div class="steps relative mt-12 lg:mt-16">
        <span class="steps-line left-[1.4375rem] top-6 bottom-6 w-0.5 md:top-[1.4375rem] md:bottom-auto md:left-6 md:right-[calc(25%-2.625rem)] md:h-0.5 md:w-auto" aria-hidden="true"></span>
        <ol class="grid gap-10 md:grid-cols-4 md:gap-6">
        {steps.map((s, i) => (
          <li class="relative grid grid-cols-[auto_1fr] gap-5 md:block">
            <span class="step-num">{i + 1}</span>
            <div class="md:mt-5">
              <h3 class="h3" set:html={T(s.title)} />
              <p class="small muted mt-2 leading-relaxed" set:html={T(s.desc)} />
            </div>
          </li>
        ))}
        </ol>
      </div>
    </div>
  </section>

  <CtaBand title={T('schools.cta.title')} desc={T('schools.cta.desc')} note={t(lang, 'schools.cta.note')} href={contactHref} label={T('schools.cta.btn')} />
</BaseLayout>
