---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { t, localePath, getStaticPaths as gsp, type Lang } from '../../i18n/utils';
import { jp } from '../../i18n/jp';

export const getStaticPaths = gsp;
const { lang } = Astro.props as { lang: Lang };
const T = (key: string) => jp(lang, t(lang, key));

const who = [
  { value: 'school', icon: 'school', title: 'contact.link.school', sub: 'contact.link.school.sub' },
  { value: 'business', icon: 'building', title: 'contact.link.business', sub: 'contact.link.business.sub' },
  { value: 'parent', icon: 'users', title: 'contact.link.parent', sub: 'contact.link.parent.sub' },
] as const;

const fields = [
  { name: 'name', label: 'contact.form.name', placeholder: 'contact.form.name.placeholder', type: 'text', req: true, autocomplete: 'name' },
  { name: 'email', label: 'contact.form.email', placeholder: 'contact.form.email.placeholder', type: 'email', req: true, autocomplete: 'email' },
  { name: 'organization', label: 'contact.form.org', placeholder: 'contact.form.org.placeholder', type: 'text', req: false, autocomplete: 'organization' },
  { name: 'role', label: 'contact.form.role', placeholder: 'contact.form.role.placeholder', type: 'text', req: false, autocomplete: 'organization-title' },
] as const;

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=1-22-11+Ginza+Chuo-ku+Tokyo';
---

<BaseLayout lang={lang} title={t(lang, 'meta.contact.title')} description={t(lang, 'meta.contact.desc')} activePage="contact">
  <section class="pt-10 pb-16 lg:pt-20 lg:pb-24">
    <div class="wrap">
      <div class="hero-stage max-w-3xl">
        <h1 class="h1" set:html={T('contact.title')} />
        <p class="lead mt-5 max-w-[34em]" set:html={T('contact.lead')} />
      </div>

      <div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-16">
        <!-- Sidebar -->
        <aside class="lg:col-span-5">
          <div class="grid gap-3" data-reveal-stagger>
            {who.map((w) => (
              <button type="button" class="card is-hover flex w-full items-center gap-5 p-5 text-left" data-select-who={w.value}>
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-mint text-rule-deep">
                  <Icon name={w.icon} size={20} />
                </span>
                <span class="flex-1">
                  <span class="block font-bold text-ink">{t(lang, w.title)}</span>
                  <span class="small muted block">{t(lang, w.sub)}</span>
                </span>
                <Icon name="arrow" size={18} class="text-ink-faint" />
              </button>
            ))}
          </div>

          <div class="mt-10 border-t border-rule-soft pt-8" data-reveal>
            <ul class="grid gap-3">
              <li class="flex items-start gap-3">
                <Icon name="map-pin" size={18} class="mt-1 shrink-0 text-rule" />
                <p class="small muted leading-relaxed" set:html={t(lang, 'contact.address')} />
              </li>
              <li class="flex items-center gap-3">
                <Icon name="mail" size={18} class="shrink-0 text-rule" />
                <a href="mailto:info@waspect.jp" class="small link">info@waspect.jp</a>
              </li>
            </ul>
            <div class="frame mt-6 aspect-[16/9] bg-mist-deep">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3241.169!2d139.7671!3d35.6722!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188be6e392b4ef%3A0x4c0e0fd8c6cf488d!2z44CSMTEwLTAwMDEg5p2x5Lqs6YO95Lit5aSu5Yy66YqA5bqnMS0yMi0xMQ!5e0!3m2!1sja!2sjp!4v1"
                width="100%"
                height="100%"
                style="border:0;filter:grayscale(1) contrast(0.95);"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={t(lang, 'contact.map.title')}
              ></iframe>
            </div>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="link small mt-3">
              {t(lang, 'about.company.map')}
              <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
        </aside>

        <!-- Form -->
        <section class="lg:col-span-7" aria-labelledby="contact-form-heading">
          <h2 id="contact-form-heading" class="sr-only">{t(lang, 'contact.title')}</h2>

          <div id="form-success" class="card hidden p-8 text-center lg:p-12" role="status" tabindex="-1">
            <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-mint text-rule-deep">
              <Icon name="check" size={26} />
            </span>
            <h3 class="h3 mt-5" set:html={T('contact.success.title')} />
            <p class="muted mt-2" set:html={T('contact.success.desc')} />
          </div>

          <div id="contact-form" class="card p-6 sm:p-8 lg:p-10" data-reveal>
            <form id="contact-form-el" class="grid gap-8" name="contact" method="POST" action={localePath(lang, '/contact/')} data-netlify="true" netlify-honeypot="bot-field">
              <input type="hidden" name="form-name" value="contact" />
              <p class="hidden" aria-hidden="true"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

              <fieldset class="grid gap-3">
                <legend class="small mb-3 font-bold text-ink">{t(lang, 'contact.form.who')}</legend>
                <div class="grid grid-cols-3 gap-3" id="identity-selector">
                  {who.map((w) => (
                    <label class="seg">
                      <input name="identity" type="radio" value={w.value} />
                      <Icon name={w.icon} size={22} />
                      <span>{t(lang, `contact.form.${w.value}`)}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="grid gap-6 md:grid-cols-2">
                {fields.map((f) => (
                  <div class="field">
                    <label for={`field-${f.name}`}>
                      {t(lang, f.label)}
                      {f.req && <span class="req" aria-hidden="true">*</span>}
                    </label>
                    <input
                      id={`field-${f.name}`}
                      class="input"
                      name={f.name}
                      type={f.type}
                      placeholder={t(lang, f.placeholder)}
                      required={f.req}
                      autocomplete={f.autocomplete}
                    />
                  </div>
                ))}
              </div>

              <div class="field">
                <label for="field-message">
                  {t(lang, 'contact.form.message')}
                  <span class="req" aria-hidden="true">*</span>
                </label>
                <textarea id="field-message" class="input" name="message" rows="5" required placeholder={t(lang, 'contact.form.message.placeholder')}></textarea>
              </div>

              <div class="grid gap-4">
                <button class="btn btn-primary btn-lg btn-block" type="submit" id="contact-submit" data-label-default={t(lang, 'contact.form.submit')} data-label-parent={t(lang, 'contact.form.submit.parent')}>
                  <span>{t(lang, 'contact.form.submit')}</span>
                  <Icon name="arrow" size={18} class="ic-arrow" />
                </button>
                <p id="form-error" class="small hidden rounded-xl bg-[#fdf0ed] px-4 py-3 text-[#8a2a1b]" role="alert">{t(lang, 'contact.form.error')}</p>
                <p class="small muted text-center text-[0.8125rem]">{t(lang, 'contact.form.disclaimer')}</p>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
  </section>

  <script>
    const radios = document.querySelectorAll<HTMLInputElement>('input[name="identity"]');
    const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const submitLabel = submit?.querySelector('span');

    function syncSubmitLabel() {
      const checked = Array.from(radios).find((r) => r.checked)?.value;
      if (submit && submitLabel) {
        submitLabel.textContent = checked === 'parent' ? submit.dataset.labelParent ?? '' : submit.dataset.labelDefault ?? '';
      }
    }

    function selectIdentity(value: string, scroll = false) {
      radios.forEach((r) => (r.checked = r.value === value));
      syncSubmitLabel();
      if (scroll) document.getElementById('contact-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-select-who]').forEach((btn) => {
      btn.addEventListener('click', () => selectIdentity(btn.dataset.selectWho ?? 'school', true));
    });
    radios.forEach((r) => r.addEventListener('change', syncSubmitLabel));

    const whoParam = new URLSearchParams(window.location.search).get('who');
    selectIdentity(whoParam && ['school', 'business', 'parent'].includes(whoParam) ? whoParam : 'school');

    const form = document.getElementById('contact-form-el') as HTMLFormElement | null;
    const wrap = document.getElementById('contact-form');
    const success = document.getElementById('form-success');
    const error = document.getElementById('form-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      error?.classList.add('hidden');
      if (submit) submit.disabled = true;
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(`Form submission failed: ${res.status}`);
        wrap?.classList.add('hidden');
        success?.classList.remove('hidden');
        success?.focus();
        success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        console.error(err);
        error?.classList.remove('hidden');
        if (submit) submit.disabled = false;
      }
    });
  </script>
</BaseLayout>
