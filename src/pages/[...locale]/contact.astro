---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, localePath, getStaticPaths as gsp, type Lang } from '../../i18n/utils';
export const getStaticPaths = gsp;
const { lang } = Astro.props as { lang: Lang };
---

<BaseLayout lang={lang} title={t(lang, 'meta.contact.title')} description={t(lang, 'meta.contact.desc')} activePage="contact">

  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-12 pb-24 lg:flex lg:gap-16">
    <!-- LEFT SIDEBAR -->
    <aside class="lg:w-2/5 mb-16 lg:mb-0">
      <div class="lg:sticky lg:top-28 space-y-10">
        <div class="hero-enter">
          <span class="badge badge-primary mb-4">{t(lang, 'contact.badge')}</span>
          <h1 class="text-[clamp(2.5rem,4vw,3.5rem)] font-headline font-bold text-primary tracking-tight leading-tight mb-4">{t(lang, 'contact.title')}</h1>
          <p class="text-lg text-on-surface-variant max-w-md leading-relaxed">{t(lang, 'contact.desc')}</p>
        </div>

        <!-- Quick links — click to select identity in the form -->
        <div class="space-y-3 hero-enter hero-enter-delay-1">
          {[
            { who: 'school', icon: 'school', title: t(lang, 'contact.link.school'), sub: t(lang, 'contact.link.school.sub') },
            { who: 'business', icon: 'corporate_fare', title: t(lang, 'contact.link.business'), sub: t(lang, 'contact.link.business.sub') },
            { who: 'parent', icon: 'family_history', title: t(lang, 'contact.link.parent'), sub: t(lang, 'contact.link.parent.sub') },
          ].map((item) => (
            <button type="button" data-select-who={item.who} class="who-link group flex items-center gap-5 p-5 card !rounded-xl w-full text-left">
              <div class="w-10 h-10 flex items-center justify-center bg-primary/5 rounded-xl text-primary group-hover:bg-primary group-hover:text-on-primary transition-all duration-300">
                <span class="material-symbols-outlined text-xl">{item.icon}</span>
              </div>
              <div class="flex-1">
                <p class="font-bold text-on-surface text-sm">{item.title}</p>
                <p class="text-xs text-on-surface-variant">{item.sub}</p>
              </div>
              <span class="material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors text-lg">chevron_right</span>
            </button>
          ))}
        </div>

        <!-- Contact details -->
        <div class="pt-8 border-t border-outline-variant/15 space-y-4 hero-enter hero-enter-delay-2">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-tertiary text-lg">location_on</span>
            <p class="text-sm text-on-surface-variant" set:html={t(lang, 'contact.address')} />
          </div>
          <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-tertiary text-lg">mail</span>
            <p class="text-sm text-on-surface-variant">info@waspect.jp</p>
          </div>
          <div class="mt-4 overflow-hidden rounded-xl h-44 w-full">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3241.169!2d139.7671!3d35.6722!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188be6e392b4ef%3A0x4c0e0fd8c6cf488d!2z44CSMTEwLTAwMDEg5p2x5Lqs6YO95Lit5aSu5Yy66YqA5bqnMS0yMi0xMQ!5e0!3m2!1sja!2sjp!4v1"
              width="100%"
              height="100%"
              style="border:0;filter:grayscale(1) opacity(0.7);"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={t(lang, 'contact.map.title')}
            ></iframe>
          </div>
        </div>
      </div>
    </aside>

    <!-- FORM -->
    <section class="lg:w-3/5">
      <div id="contact-form" class="card stone-surface p-8 lg:p-12 !rounded-2xl border border-outline-variant/10 hero-enter hero-enter-delay-1">
        <form class="space-y-8" name="contact" method="POST" action={localePath(lang, '/contact/')} data-netlify="true" netlify-honeypot="bot-field">
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
          <!-- Identity Selector -->
          <fieldset class="space-y-3">
            <legend class="font-label font-bold text-sm text-on-surface block">{t(lang, 'contact.form.who')}</legend>
            <div class="grid grid-cols-3 gap-3" id="identity-selector">
              {[
                { value: 'school', icon: 'school', label: t(lang, 'contact.form.school') },
                { value: 'business', icon: 'apartment', label: t(lang, 'contact.form.business') },
                { value: 'parent', icon: 'family_restroom', label: t(lang, 'contact.form.parent') },
              ].map((opt) => (
                <label class="identity-option relative flex flex-col items-center gap-2 p-5 rounded-xl border-2 border-surface-container hover:bg-surface-container-low transition-all cursor-pointer has-checked:border-primary has-checked:bg-primary/3 group">
                  <input name="identity" type="radio" value={opt.value} class="sr-only" />
                  <span class="material-symbols-outlined text-2xl text-outline group-hover:text-primary transition-colors">{opt.icon}</span>
                  <span class="font-label text-xs font-bold text-on-surface-variant">{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Fields -->
          <div class="grid md:grid-cols-2 gap-6">
            {[
              { name: 'name', label: t(lang, 'contact.form.name'), placeholder: t(lang, 'contact.form.name.placeholder'), type: 'text', req: true },
              { name: 'email', label: t(lang, 'contact.form.email'), placeholder: t(lang, 'contact.form.email.placeholder'), type: 'email', req: true },
              { name: 'organization', label: t(lang, 'contact.form.org'), placeholder: t(lang, 'contact.form.org.placeholder'), type: 'text', req: false },
              { name: 'role', label: t(lang, 'contact.form.role'), placeholder: t(lang, 'contact.form.role.placeholder'), type: 'text', req: false },
            ].map((field) => (
              <div class="space-y-1.5">
                <label for={`field-${field.name}`} class="font-label font-bold text-[11px] text-primary uppercase tracking-wider">{field.label}{field.req && <span class="text-secondary ml-0.5">*</span>}</label>
                <input
                  id={`field-${field.name}`}
                  name={field.name}
                  type={field.type as astroHTML.JSX.HTMLInputTypeAttribute}
                  placeholder={field.placeholder}
                  required={field.req}
                  class="w-full bg-surface-container-high/50 border-0 border-b-2 border-transparent focus:border-primary focus:bg-surface-container-lowest rounded-lg transition-all px-4 py-2.5 text-sm text-on-surface placeholder:text-outline/40 focus:ring-0"
                />
              </div>
            ))}
          </div>

          <div class="space-y-1.5">
            <label for="field-message" class="font-label font-bold text-[11px] text-primary uppercase tracking-wider">{t(lang, 'contact.form.message')}<span class="text-secondary ml-0.5">*</span></label>
            <textarea
              id="field-message"
              name="message"
              placeholder={t(lang, 'contact.form.message.placeholder')}
              rows="4"
              required
              class="w-full bg-surface-container-high/50 border-0 border-b-2 border-transparent focus:border-primary focus:bg-surface-container-lowest rounded-lg transition-all px-4 py-2.5 text-sm text-on-surface placeholder:text-outline/40 focus:ring-0 resize-none"
            ></textarea>
          </div>

          <button class="btn btn-primary w-full py-4" type="submit">
            {t(lang, 'contact.form.submit')}
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </button>
          <p class="text-center text-[11px] text-on-surface-variant/50">{t(lang, 'contact.form.disclaimer')}</p>
        </form>
      </div>

      <!-- Trust markers -->
      <div class="mt-10 flex flex-wrap justify-center lg:justify-start gap-8 opacity-30">
        {[
          { icon: 'verified_user', label: t(lang, 'contact.trust.standards') },
          { icon: 'lock', label: t(lang, 'contact.trust.secure') },
          { icon: 'support_agent', label: t(lang, 'contact.trust.response') },
        ].map((item) => (
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">{item.icon}</span>
            <span class="font-label font-bold text-[10px] uppercase tracking-widest">{item.label}</span>
          </div>
        ))}
      </div>
    </section>
  </div>

  <script>
    function selectIdentity(value: string) {
      const radios = document.querySelectorAll<HTMLInputElement>('input[name="identity"]');
      radios.forEach((r) => { r.checked = r.value === value; });
      // Scroll form into view on mobile
      document.getElementById('contact-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Sidebar buttons select the identity and scroll to form
    document.querySelectorAll<HTMLButtonElement>('.who-link').forEach((btn) => {
      btn.addEventListener('click', () => {
        const who = btn.dataset.selectWho;
        if (who) selectIdentity(who);
      });
    });

    // URL query param: /contact?who=parent pre-selects
    const params = new URLSearchParams(window.location.search);
    const whoParam = params.get('who');
    if (whoParam) {
      selectIdentity(whoParam);
    } else {
      // Default to school
      selectIdentity('school');
    }
  </script>

</BaseLayout>
