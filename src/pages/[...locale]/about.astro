---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { t, localePath, getStaticPaths as gsp, type Lang } from '../../i18n/utils';
import { jp } from '../../i18n/jp';
import founders from '../../assets/photos/founders-newswitch.jpg';
import shiboriBinding from '../../assets/photos/shibori-binding.jpg';
import shiboriSun from '../../assets/photos/shibori-sunlight.jpg';
import bonsai from '../../assets/photos/bonsai-detail.jpg';
import mashio from '../../assets/photos/mashio.jpg';
import stefan from '../../assets/photos/stefan.jpg';
import ginza from '../../assets/photos/ginza-night.jpg';

export const getStaticPaths = gsp;
const { lang } = Astro.props as { lang: Lang };
const T = (key: string) => jp(lang, t(lang, key));

const people = [
  { img: mashio, name: 'about.mashio.name', role: 'about.mashio.role', bio: 'about.mashio.bio' },
  { img: stefan, name: 'about.stefan.name', role: 'about.stefan.role', bio: 'about.stefan.bio' },
];

const values = [
  { title: 'about.values.1.title', desc: 'about.values.1.desc' },
  { title: 'about.values.2.title', desc: 'about.values.2.desc' },
  { title: 'about.values.3.title', desc: 'about.values.3.desc' },
] as const;

const company = [
  { label: 'about.company.name.label', value: 'about.company.name' },
  { label: 'about.company.rep.label', value: 'about.company.rep' },
  { label: 'about.company.address.label', value: 'about.company.address' },
  { label: 'about.company.founded.label', value: 'about.company.founded' },
  { label: 'about.company.business.label', value: 'about.company.business' },
  { label: 'about.company.lang.label', value: 'about.company.lang' },
];
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=1-22-11+Ginza+Chuo-ku+Tokyo';
---

<BaseLayout title={t(lang, 'meta.about.title')} description={t(lang, 'meta.about.desc')} activePage="about" lang={lang}>
  <PageHero title={T('about.hero.title')} lead={T('about.hero.lead')} image={founders} alt={t(lang, 'about.hero.alt')} position="50% 30%">
    <Fragment slot="actions">
      <a href={localePath(lang, '/contact')} class="btn btn-primary btn-lg w-full sm:w-auto">
        <span set:html={T('common.contact')} />
        <Icon name="arrow" size={18} class="ic-arrow" />
      </a>
    </Fragment>
    <Fragment slot="facts">
      <span class="fact"><Icon name="map-pin" size={16} />{t(lang, 'about.hero.place')}</span>
      <span class="fact"><Icon name="languages" size={16} />{t(lang, 'about.company.lang')}</span>
    </Fragment>
    <Fragment slot="overlay">
      <p class="small muted mt-3">{t(lang, 'about.founders.caption')}</p>
    </Fragment>
  </PageHero>

  <!-- Story -->
  <section class="section tint">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHead title={T('about.story.title')} />
        <div class="prose muted mt-6 grid gap-4 leading-relaxed" data-reveal>
          <p set:html={T('about.story.p1')} />
          <p set:html={T('about.story.p2')} />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 lg:col-span-7 lg:gap-5" data-reveal-stagger>
        <div class="frame aspect-[3/4] self-end bg-mist-deep">
          <Image src={shiboriBinding} alt={t(lang, 'about.story.alt1')} width={900} widths={[400, 640, 900]} sizes="(min-width: 1200px) 304px, (min-width: 1024px) 28vw, 50vw" format="webp" quality={78} />
        </div>
        <div class="grid gap-4 lg:gap-5">
          <div class="frame aspect-[4/3] bg-mist-deep">
            <Image src={shiboriSun} alt={t(lang, 'about.story.alt2')} width={900} widths={[400, 640, 900]} sizes="(min-width: 1200px) 304px, (min-width: 1024px) 28vw, 50vw" format="webp" quality={78} />
          </div>
          <div class="frame aspect-[4/3] bg-mist-deep">
            <Image src={bonsai} alt={t(lang, 'about.story.alt3')} width={900} widths={[400, 640, 900]} sizes="(min-width: 1200px) 304px, (min-width: 1024px) 28vw, 50vw" format="webp" quality={78} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Founders -->
  <section class="section">
    <div class="wrap">
      <SectionHead title={T('about.founders.title')} />
      <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-2 lg:gap-16" data-reveal-stagger>
        {people.map((p) => (
          <article class="grid gap-6 sm:grid-cols-[9rem_1fr] sm:gap-8">
            <div class="frame aspect-square w-36 bg-mist-deep">
              <Image src={p.img} alt="" width={288} height={288} format="webp" quality={82} />
            </div>
            <div>
              <h3 class="h3 latin">{t(lang, p.name)}</h3>
              <p class="small mt-1 font-bold text-rule-deep">{t(lang, p.role)}</p>
              <p class="prose muted mt-4 leading-relaxed" set:html={T(p.bio)} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section tint">
    <div class="wrap">
      <SectionHead title={T('about.values.title')} />
      <ul class="mt-12 grid gap-x-10 gap-y-10 lg:mt-16 lg:grid-cols-3" data-reveal-stagger>
        {values.map((v) => (
          <li class="border-t border-rule-soft pt-6">
            <h3 class="h3" set:html={T(v.title)} />
            <p class="muted mt-2 max-w-[40em] leading-relaxed" set:html={T(v.desc)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Company -->
  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHead title={T('about.company.title')} />
        <dl class="ruled mt-10" data-reveal>
          {company.map((row) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="small muted">{t(lang, row.label)}</dt>
              <dd class="text-ink" set:html={T(row.value)} />
            </div>
          ))}
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <dt class="small muted">{t(lang, 'about.company.email.label')}</dt>
            <dd><a href="mailto:info@waspect.jp" class="link">info@waspect.jp</a></dd>
          </div>
        </dl>
      </div>
      <div class="lg:col-span-5" data-reveal>
        <div class="frame aspect-[4/5] bg-mist-deep">
          <Image src={ginza} alt={t(lang, 'about.company.alt')} width={1100} widths={[480, 760, 1100]} sizes="(min-width: 1200px) 429px, (min-width: 1024px) 40vw, 100vw" format="webp" quality={78} />
        </div>
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="link small mt-4">
          {t(lang, 'about.company.map')}
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  <CtaBand title={T('home.cta.title')} desc={T('home.cta.desc')} href={localePath(lang, '/contact')} label={T('home.cta.btn')} />
</BaseLayout>
