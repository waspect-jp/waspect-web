---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Waspect" description="The page you're looking for doesn't exist." lang="ja">
  <section class="min-h-[60vh] flex items-center justify-center px-6">
    <div class="text-center max-w-md">
      <span class="text-8xl font-headline font-extrabold text-primary/20">404</span>
      <h1 class="text-2xl font-headline font-bold text-primary mt-4 mb-4">Page Not Found</h1>
      <p class="text-on-surface-variant mb-8">The page you're looking for doesn't exist or has been moved.</p>
      <div class="flex gap-3 justify-center">
        <a href="/" class="btn btn-primary btn-sm">ホームへ戻る</a>
        <a href="/en/" class="btn btn-ghost btn-sm">Go to English Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
