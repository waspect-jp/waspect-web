---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Hero shared by the four sub-pages: title and lead on the left,
 * a real photograph on the right, actions and facts below the lead.
 */
interface Props {
  title: string; // HTML (already passed through jp())
  lead: string; // HTML
  image: ImageMetadata;
  alt: string;
  position?: string; // object-position for the crop
}
const { title, lead, image, alt, position = '50% 50%' } = Astro.props;
---

<section class="relative overflow-hidden pt-10 pb-16 lg:pt-20 lg:pb-24">
  <div class="wrap grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="hero-stage lg:col-span-6">
      <h1 class="h1" set:html={title} />
      <p class="lead mt-6 max-w-[34em]" set:html={lead} />
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
      <div class="facts mt-8">
        <slot name="facts" />
      </div>
    </div>
    <div class="hero-media relative lg:col-span-6">
      <div class="frame aspect-[4/3] bg-mist lg:aspect-[5/4]">
        <Image
          src={image}
          alt={alt}
          width={1600}
          widths={[560, 840, 1200, 1600]}
          sizes="(min-width: 1200px) 528px, (min-width: 1024px) 50vw, 100vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          style={`object-position: ${position}`}
        />
      </div>
      <slot name="overlay" />
    </div>
  </div>
</section>
