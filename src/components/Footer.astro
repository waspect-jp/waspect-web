---
import { t, localePath, type Lang } from '../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'ja' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="relative mt-32 overflow-hidden">
  <div class="accent-gradient-line"></div>
  <div class="bg-surface-container-low ink-wash py-20 px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16">
        <div class="md:col-span-4">
          <a href={localePath(lang, '/')} class="flex items-center gap-3 mb-6">
            <img src="/images/logo.png" alt="Waspect" class="h-9 w-auto" width="36" height="36" />
            <div class="flex flex-col">
              <span class="text-lg font-extrabold text-primary font-headline tracking-tight leading-none">Waspect</span>
              <span class="text-[10px] text-on-surface-variant/60 font-medium tracking-widest">和スペクト</span>
            </div>
          </a>
          <p class="text-on-surface-variant text-sm leading-relaxed max-w-xs mb-8">{t(lang, 'footer.description')}</p>
          <div class="flex gap-3">
            <a href="mailto:info@waspect.jp" class="w-10 h-10 rounded-full bg-surface-container inline-flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all duration-300" aria-label="Email">
              <span class="material-symbols-outlined text-[18px]">mail</span>
            </a>
            <a href="https://www.instagram.com/waspect_jp/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-surface-container inline-flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all duration-300" aria-label="Instagram">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://www.facebook.com/people/Waspect/61566549808615/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-surface-container inline-flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-on-primary transition-all duration-300" aria-label="Facebook">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385h-3.047v-3.47h3.047v-2.642c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.514c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385c5.737-.9 10.125-5.864 10.125-11.854z"/></svg>
            </a>
          </div>
        </div>
        <div class="md:col-span-2">
          <h4 class="text-xs font-bold text-primary uppercase tracking-[0.15em] mb-5">{t(lang, 'footer.services')}</h4>
          <ul class="space-y-3">
            <li><a class="text-on-surface-variant text-sm hover:text-primary transition-colors duration-200" href={localePath(lang, '/schools')}>{t(lang, 'nav.schools')}</a></li>
            <li><a class="text-on-surface-variant text-sm hover:text-primary transition-colors duration-200" href={localePath(lang, '/businesses')}>{t(lang, 'nav.businesses')}</a></li>
            <li><a class="text-on-surface-variant text-sm hover:text-primary transition-colors duration-200" href={localePath(lang, '/kids')}>{t(lang, 'nav.kids')}</a></li>
          </ul>
        </div>
        <div class="md:col-span-2">
          <h4 class="text-xs font-bold text-primary uppercase tracking-[0.15em] mb-5">{t(lang, 'footer.company')}</h4>
          <ul class="space-y-3">
            <li><a class="text-on-surface-variant text-sm hover:text-primary transition-colors duration-200" href={localePath(lang, '/about')}>{t(lang, 'footer.about')}</a></li>
            <li><a class="text-on-surface-variant text-sm hover:text-primary transition-colors duration-200" href={localePath(lang, '/contact')}>{t(lang, 'footer.contact')}</a></li>
          </ul>
        </div>
        <div class="md:col-span-4">
          <h4 class="text-xs font-bold text-primary uppercase tracking-[0.15em] mb-5">{t(lang, 'footer.newsletter')}</h4>
          <p class="text-on-surface-variant text-sm mb-4">{t(lang, 'footer.newsletter.desc')}</p>
          <form class="flex gap-2" name="newsletter" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field">
            <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
            <input name="email" class="flex-1 bg-surface-container-lowest border border-outline-variant/20 rounded-full py-2.5 px-4 text-sm text-on-surface placeholder:text-outline/40 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" placeholder={t(lang, 'footer.newsletter.placeholder')} type="email" required aria-label="Email" />
            <button type="submit" class="btn btn-primary btn-sm px-5" aria-label="Subscribe">
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
          </form>
        </div>
      </div>
      <div class="mt-16 pt-8 border-t border-outline-variant/15 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-on-surface-variant/60">
        <p>&copy; {currentYear} {t(lang, 'footer.copyright')}</p>
      </div>
    </div>
  </div>
</footer>
