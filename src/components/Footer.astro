---
import Icon from './Icon.astro';
import { t, localePath, switchLangPath, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
  switchUrl?: string;
}
const { lang = 'ja' } = Astro.props;
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const switchUrl = Astro.props.switchUrl ?? switchLangPath(lang, currentPath.replace(/^\/en/, '') || '/');
---

<footer class="mt-24 border-t border-rule-faint bg-mist lg:mt-32">
  <div class="wrap py-16 lg:py-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <a href={localePath(lang, '/')} class="inline-flex items-center gap-3 no-underline" aria-label={t(lang, 'nav.home')}>
          <img src="/images/logo.png" alt="" width="40" height="40" class="h-10 w-10" />
          <span class="grid gap-0.5 leading-none">
            <span class="latin text-[1.125rem] font-extrabold tracking-tight text-ink">Waspect</span>
            <span class="text-[0.6875rem] font-medium tracking-[0.14em] text-ink-muted" lang="ja">和スペクト</span>
          </span>
        </a>
        <p class="small muted mt-5 max-w-xs leading-relaxed">{t(lang, 'footer.description')}</p>
        <div class="mt-6 flex gap-2">
          <a
            href="mailto:info@waspect.jp"
            class="grid h-10 w-10 place-items-center rounded-full border border-rule-soft bg-white text-ink-muted transition-colors hover:border-ink hover:text-ink"
            aria-label={t(lang, 'about.company.email.label')}
          >
            <Icon name="mail" size={18} />
          </a>
          <a
            href="https://www.instagram.com/waspect_jp/"
            target="_blank"
            rel="noopener noreferrer"
            class="grid h-10 w-10 place-items-center rounded-full border border-rule-soft bg-white text-ink-muted transition-colors hover:border-ink hover:text-ink"
            aria-label="Instagram"
          >
            <Icon name="instagram" size={18} />
          </a>
          <a
            href="https://www.facebook.com/people/Waspect/61566549808615/"
            target="_blank"
            rel="noopener noreferrer"
            class="grid h-10 w-10 place-items-center rounded-full border border-rule-soft bg-white text-ink-muted transition-colors hover:border-ink hover:text-ink"
            aria-label="Facebook"
          >
            <Icon name="facebook" size={18} />
          </a>
        </div>
      </div>

      <nav class="lg:col-span-2" aria-label={t(lang, 'footer.services')}>
        <p class="small font-bold text-ink">{t(lang, 'footer.services')}</p>
        <ul class="mt-4 grid gap-1">
          <li><a class="small muted inline-flex min-h-9 items-center no-underline hover:text-ink" href={localePath(lang, '/schools')}>{t(lang, 'nav.schools')}</a></li>
          <li><a class="small muted inline-flex min-h-9 items-center no-underline hover:text-ink" href={localePath(lang, '/businesses')}>{t(lang, 'nav.businesses')}</a></li>
          <li><a class="small muted inline-flex min-h-9 items-center no-underline hover:text-ink" href={localePath(lang, '/kids')}>{t(lang, 'nav.kids')}</a></li>
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <p class="small font-bold text-ink">{t(lang, 'footer.company')}</p>
        <ul class="mt-4 grid gap-1">
          <li><a class="small muted inline-flex min-h-9 items-center no-underline hover:text-ink" href={localePath(lang, '/about')}>{t(lang, 'footer.about')}</a></li>
          <li><a class="small muted inline-flex min-h-9 items-center no-underline hover:text-ink" href={localePath(lang, '/contact')}>{t(lang, 'footer.contact')}</a></li>
        </ul>
        <p class="small muted mt-5 leading-relaxed"><span set:html={t(lang, 'footer.address')} /><br /><a class="hover:text-ink" href="mailto:info@waspect.jp">info@waspect.jp</a></p>
      </div>

      <div class="lg:col-span-3">
        <p class="small font-bold text-ink">{t(lang, 'footer.newsletter')}</p>
        <p class="small muted mt-4 leading-relaxed">{t(lang, 'footer.newsletter.desc')}</p>
        <form
          id="newsletter-form"
          class="mt-4 flex flex-col gap-2"
          name="newsletter"
          method="POST"
          action="/"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="hidden" aria-hidden="true"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <label class="sr-only" for="newsletter-email">{t(lang, 'contact.form.email')}</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="input min-w-0 flex-1 rounded-full px-5"
            placeholder={t(lang, 'footer.newsletter.placeholder')}
          />
          <button type="submit" class="btn btn-primary self-start">{t(lang, 'footer.newsletter.btn')}</button>
        </form>
        <p id="newsletter-success" class="mt-4 hidden items-center gap-2 text-sm font-bold text-rule-deep" role="status" tabindex="-1">
          <Icon name="check-circle" size={18} />
          {t(lang, 'footer.newsletter.success')}
        </p>
        <p id="newsletter-error" class="small mt-3 hidden rounded-xl bg-[#fdf0ed] px-4 py-3 text-[#8a2a1b]" role="alert">{t(lang, 'footer.newsletter.error')}</p>
      </div>
    </div>

    <div class="small muted mt-14 flex flex-col items-start justify-between gap-4 border-t border-rule-soft pt-6 md:flex-row md:items-center">
      <p>&copy; {year} {t(lang, 'footer.copyright')}</p>
      <a href={switchUrl} class="latin link" lang={lang === 'ja' ? 'en' : 'ja'}>{t(lang, 'nav.lang')}</a>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const success = document.getElementById('newsletter-success');
  const error = document.getElementById('newsletter-error');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    error?.classList.add('hidden');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
      if (!res.ok) throw new Error(`Newsletter submission failed: ${res.status}`);
      form.classList.add('hidden');
      success?.classList.remove('hidden');
      success?.classList.add('flex');
      success?.focus();
    } catch (err) {
      console.error(err);
      error?.classList.remove('hidden');
      if (button) button.disabled = false;
    }
  });
</script>
